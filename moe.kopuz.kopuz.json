{
  "app-id": "moe.kopuz.kopuz",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "kopuz",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "separate-locales": false,
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri",
    "--share=network",
    "--filesystem=xdg-music:ro",
    "--filesystem=xdg-download:ro",
    "--filesystem=xdg-run/discord-ipc-0",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.mpris.MediaPlayer2.*",
    "--own-name=org.mpris.MediaPlayer2.kopuz",
    "--talk-name=org.freedesktop.secrets"
  ],
  "build-options": {
    "strip": true,
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "modules": [
    {
      "name": "kopuz",
      "buildsystem": "simple",
      "build-options": {
        "strip": true,
        "env": {
          "CARGO_HOME": "/run/build/kopuz/cargo",
          "CARGO_NET_OFFLINE": "true",
          "RUSTY_V8_ARCHIVE": "/run/build/kopuz/librusty.a.gz",
          "SQLX_OFFLINE": "true"
        }
      },
      "build-commands": [
        "cargo build --release --offline --locked -p kopuz -p kopuz-kopuzd -p kopuz-ctl",
        "install -Dm755 -t $FLATPAK_DEST/bin target/release/kopuz target/release/kopuzd target/release/kopuzctl",
        "install -Dm644 data/$FLATPAK_ID.desktop $FLATPAK_DEST/share/applications/$FLATPAK_ID.desktop",
        "install -Dm644 data/$FLATPAK_ID.metainfo.xml $FLATPAK_DEST/share/metainfo/$FLATPAK_ID.metainfo.xml",
        "install -Dm644 apps/legacy/kopuz/assets/logo-512.png $FLATPAK_DEST/share/icons/hicolor/512x512/apps/$FLATPAK_ID.png",
        "install -Dm644 apps/legacy/kopuz/assets/logo-128.png $FLATPAK_DEST/share/icons/hicolor/128x128/apps/$FLATPAK_ID.png"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/Kopuz-org/kopuz.git",
          "tag": "v0.67.0",
          "commit": "7c25238faece34ac40196affaa3340e83c6a77cc",
          "x-checker-data": {
            "type": "git",
            "is-main-source": true,
            "tag-pattern": "^v(\\d+\\.\\d+\\.\\d+)$"
          }
        },
        "cargo-sources.json",
        "librusty.json"
      ]
    }
  ]
}
